						<Id>1781003606894</Id>
						<Name>getMaxCooks</Name>
						<X>360</X>
						<Y>-500</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body>int maxCooks = 0;&#xD;
for(double t = 0; t &lt; 7 * 24; t += 1) { &#xD;
    int val = cooksSchedule.getValue(t, HOUR); &#xD;
    if(val &gt; maxCooks) {&#xD;
        maxCooks = val;&#xD;
    }&#xD;
}&#xD;
&#xD;
return maxCooks;</Body>
