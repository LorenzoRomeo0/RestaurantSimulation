						<Exceptions/>
					</Schedule>
					<Schedule>
						<Id>1772014350792</Id>
						<Name>cooksSchedule</Name>
						<X>320</X>
						<Y>-800</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<ValueType>integer</ValueType>
						<UnitType>NONE</UnitType>
						<UnitOfValue Class="RateUnits">PER_HOUR</UnitOfValue>
						<DefaultValue>0</DefaultValue>
						<RepresentationMode>intervals</RepresentationMode>
						<RepresentationType>calendar</RepresentationType>
						<FirstDayOfWeek>monday</FirstDayOfWeek>
						<TimeUnitsInterval>hours</TimeUnitsInterval>
						<RepeatTime>604800000</RepeatTime>
						<RepeatTimeInterval>weeks</RepeatTimeInterval>
						<IsSnapTo>false</IsSnapTo>
						<SnapTo>1770220734229</SnapTo>
						<SnapToTimeUnits>minutes</SnapToTimeUnits>
						<AllDayExceptionMode>false</AllDayExceptionMode>
						<LoadFromDatabase>true</LoadFromDatabase>
						<IntervalsQuery>
							<Id>1772014350790</Id>
							<TableReference>
								<PackageName>restaurant_2025</PackageName>
								<ClassName>employees_schedule</ClassName>
							</TableReference>
							<Condition>
								<Id>1779966768332</Id>
								<ColumnReference>
									<PackageName>restaurant_2025</PackageName>
									<ClassName>employees_schedule</ClassName>
									<ItemName>scenario</ItemName>
								</ColumnReference>
								<Value Class="CodeValue">
									<Code>employeesScheduleScenario</Code>
								</Value>
								<Operator>EQUALS</Operator>
							</Condition>
							<StartColumnReference>
								<PackageName>restaurant_2025</PackageName>
								<ClassName>employees_schedule</ClassName>
								<ItemName>start_timestamp</ItemName>
							</StartColumnReference>
							<EndColumnReference>
								<PackageName>restaurant_2025</PackageName>
								<ClassName>employees_schedule</ClassName>
								<ItemName>end_timestamp</ItemName>
							</EndColumnReference>
							<ValueColumnReference>
								<PackageName>restaurant_2025</PackageName>
								<ClassName>employees_schedule</ClassName>
								<ItemName>cooks</ItemName>
							</ValueColumnReference>
						</IntervalsQuery>
						<Action>int currentlyOnShift = 0;
for (Cook w : cooks) {
    if (!w.isOffShift || w.startShiftRequested) {
        currentlyOnShift++;
    }
}

// turni da iniziare
if (currentlyOnShift &lt; value) {
    int needed = value - currentlyOnShift;
    for (Cook w : cooks) {
        if (needed &gt; 0 &amp;&amp; w.isOffShift &amp;&amp; !w.startShiftRequested) {
            w.requestShiftStart();
            needed--;
        }
    }
}

//turni da terminare
else if (currentlyOnShift &gt; value) {
    int toRemove = currentlyOnShift - value;
    for (Cook w : cooks) {
        if (toRemove &gt; 0 &amp;&amp; (!w.isOffShift &amp;&amp; !w.endShiftRequested)) {
            w.requestShiftEnd();
            toRemove--;
        }
    }
}

registerCooksShiftEvent(
	date(), 
	timeToDate(self.getTimeOfNextValue()), 
	value
);


//traceln("COOKS value: " + value + "\ncurrentlyOn: " + currentlyOnShift + "\nneeded: "+ (value - currentlyOnShift) + "\nterminate: " + (currentlyOnShift - value)+ "\n--");</Action>
