						<Name>waitersPoolDebugTextUpdater</Name>
						<X>-600</X>
						<Y>-180</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body>StringBuilder sb = new StringBuilder();&#xD;
&#xD;
for (Waiter w : waiters) {&#xD;
    Agent owner = w.getServicedEntity();   // null se il waiter è libero&#xD;
&#xD;
    if (waitersPool.containsUnit(w)) {&#xD;
        sb.append("[ \n")&#xD;
        .append(w)&#xD;
          .append(" -&gt; ")&#xD;
          .append(owner == null ? "no owner" : owner.getClass().getName() + " " + owner.getId())&#xD;
          .append("\n ] \n");&#xD;
    }&#xD;
}&#xD;
&#xD;
&#xD;
waitersPoolDebugText.setText(sb.toString());</Body>
					</Function>
