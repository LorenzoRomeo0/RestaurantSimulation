	"lastShiftDay = " + lastShiftDay + "\n" +&#xD;
	"currentOrder = " + currentOrder + "\n" +&#xD;
	"isSeized = " + isSeized + "\n" +&#xD;
	"foundTable = " + foundTable + "\n" +&#xD;
	"currentCustomers = " + (currentCustomers == null ? "null" : currentCustomers.getId()) + "\n";&#xD;
	&#xD;
