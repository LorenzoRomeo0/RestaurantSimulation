						<Body>double total = 0.0;&#xD;
&#xD;
for (Order order : orders) {&#xD;
    if (order != null) {&#xD;
        total += order.getTotalPrice();&#xD;
    }&#xD;
}&#xD;
&#xD;
moneySpentText.setText("€" + total);</Body>
