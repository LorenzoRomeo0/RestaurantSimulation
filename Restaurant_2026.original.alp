					<StatechartElement Class="State" ParentState="ROOT_NODE">
						<Id>1775060505849</Id>
						<Name>offShift</Name>
						<X>720</X>
						<Y>50</Y>
						<Label>
							<X>10</X>
							<Y>10</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Properties Width="100" Height="30">
							<EntryAction>if(!endShiftRequested){ //era overtime
	wasOvertime = true;
	
	Date end = date();

	Calendar cal = Calendar.getInstance();
	cal.setTime(end);
	cal.set(Calendar.HOUR_OF_DAY, main.closingTime);
	cal.set(Calendar.MINUTE, 0);
	cal.set(Calendar.SECOND, 0);
	cal.set(Calendar.MILLISECOND, 0);
	
	Date overtimeStart = cal.getTime();
	
	if (end.before(overtimeStart)) {
	    cal.add(Calendar.DAY_OF_MONTH, -1);
	    overtimeStart = cal.getTime();
	}
	
	double value = (end.getTime() - overtimeStart.getTime()) / 3600000.0;
	
	if (value &gt; 0 &amp;&amp; value &lt; 24) {
	    main.registerWaiterOvertimeEvent(overtimeStart, end, value);
		//traceln("current time: " + format(end) + " | registered an overtime of: " + value);
	};
}

shiftEndDate = date();

//main.register_waiter_shift(shiftStartDate, shiftEndDate);

isOffShift = true;
endShiftRequested = false;

_ps7.setFillColor(red);


this.moveTo(main.waitersNode);</EntryAction>
							<FillColor/>
