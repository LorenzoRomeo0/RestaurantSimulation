							<Value Class="CodeValue">
								<Code><![CDATA[traceln("---> GoServe sent from "+ agent.getId() +" to waiter " + unit.getId());
/*
Waiter seizedUnit = (Waiter) unit;
traceln("--> Agent status: " + seizedUnit.waiter_statechart.getActiveSimpleState().name());
traceln("--> free waiters:");
for (Waiter w : waitersPool) {
  if (w.isIdle()) traceln("  waiter " + w.getId() + " is IDLE");
}
*/
GoServeMessage msg = new GoServeMessage(agent);
send(msg, unit);
]]></Code>
							</Value>
