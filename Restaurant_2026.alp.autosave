					<Action><![CDATA[int d = getDayOfWeek() - 1;
int h = getHourOfDay();

double avg = 0;
if (customer_wait_count[d][h] > 0) {
    avg = customer_wait_sum[d][h] / customer_wait_count[d][h];
}

customerWaitAvgByDay[d].add(h, avg);]]></Action>
