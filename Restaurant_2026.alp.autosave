					<Body><![CDATA[return
	"{\nid = " + getId() + "\n" +
	//"shiftStartDate = " + shiftStartDate + "\n" +
	//"shiftEndDate = " + shiftEndDate + "\n" +
	"isOffShift = " + isOffShift + "\n" +
