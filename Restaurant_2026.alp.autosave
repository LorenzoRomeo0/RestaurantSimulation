	+ "\ndays = { \n" +
	timeEvents.prettyPrint(
		timeEvents.groupByDayAndFilterByEndHourAndEventType(
			closingTime, TimeEvent.EventType.COOK_SHIFT
		)
	)
);




















































]]></Body>
