					<Id>1778769341205</Id>
					<Name><![CDATA[waitersPoolDebugTextUpdater]]></Name>
					<X>-600</X><Y>-130</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[StringBuilder sb = new StringBuilder();

for (Waiter w : waiters) {
    Agent owner = w.getServicedEntity();   // null se il waiter è libero

    if (waitersPool.containsUnit(w)) {
        sb.append("[ \n")
        .append(w)
          .append(" -> ")
          .append(owner == null ? "no owner" : owner.getClass().getName() + " " + owner.getId())
          .append("\n ] \n");
    }
}


waitersPoolDebugText.setText(sb.toString());]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
