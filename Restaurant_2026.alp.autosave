					<Text><![CDATA[text]]></Text>
					<TextCode><![CDATA[getId() +" [" + getIndex() +"] " + (waiter_statechart.getActiveSimpleState().name() 

 


)


/*
+ "\n" + (isOffShift ? "offShift":"onShift") + 
"\n" + "start " + shiftStartDate +  
"\n" + "end " + shiftEndDate + 
"\n" + "lastShift: " + lastShiftDay	+
"\n" + (isMoving() ? "moving":"") +
"\n" + (endShiftRequested ? "endRequested" : "") +
"\n" + (startShiftRequested ? "startRequested" : "") +
"\n" + (wasOvertime ? "wasOvertime" : "") 
*/]]></TextCode>
