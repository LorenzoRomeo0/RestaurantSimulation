			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1769810442527</Id>
					<Name><![CDATA[insideTableMaxSize]]></Name>
					<X>20</X><Y>280</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int maxSize = 0;

for(Table t : insideTablesPool){
	if(t.size > maxSize)maxSize = t.size;
}
return maxSize;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Table]]></ReturnType>
					<Id>1770025342170</Id>
					<Name><![CDATA[tableSelection]]></Name>
					<X>20</X><Y>310</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[customerGroup]]></Name>
						<Type><![CDATA[CustomerGroup]]></Type>
					</Parameter>
					<Body><![CDATA[int n = 0;
for (Table t : insideTablesPool){
	if (t.isFree) n++;
}
for (Table t : outsideTablesPool){
	if (t.isFree) n++;
}
for (Table t : barTablesPool){
	if (t.isFree) n++;
}
System.out.println("Available tables: " + n);

//usare resourcepool?

for(Table t : insideTablesPool){
	if(t.isFree && t.size >= customerGroup.size){
		t.isFree = false;
		return t;
	}
}

for(Table t : outsideTablesPool){
	if(t.isFree && t.size >= customerGroup.size){
		t.isFree = false;
		return t;
	}
}

for(Table t : barTablesPool){
	if(t.isFree && t.size >= customerGroup.size){
		t.isFree = false;
		return t;
	}
}

return null;]]></Body>
				</Function>
			</Functions>
