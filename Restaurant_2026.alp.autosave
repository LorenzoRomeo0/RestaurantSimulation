					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double min = minGroupSize;
double max = maxGroupsize;
double mu = groupsize_schedule.getValue();
double sigma = sigmaGroupSize;

return (int) normal(min, max, mu, sigma);]]></Body>
				</Function>
