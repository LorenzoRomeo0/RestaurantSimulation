								<ItemName><![CDATA[start_timestamp]]></ItemName>
							</StartColumnReference>
							<EndColumnReference>
								<PackageName><![CDATA[restaurant_2025]]></PackageName>
								<ClassName><![CDATA[employees_schedule]]></ClassName>
								<ItemName><![CDATA[end_timestamp]]></ItemName>
							</EndColumnReference>
							<ValueColumnReference>
								<PackageName><![CDATA[restaurant_2025]]></PackageName>
								<ClassName><![CDATA[employees_schedule]]></ClassName>
								<ItemName><![CDATA[waiters]]></ItemName>
							</ValueColumnReference>
					</IntervalsQuery>
					<Action><![CDATA[int currentlyOnShift = 0;
for (Waiter w : waiters) {
    if (!w.isOffShift || w.startShiftRequested) {
        currentlyOnShift++;
    }
}

// turni da iniziare
if (currentlyOnShift < value) {
    int needed = value - currentlyOnShift;
    for (Waiter w : waiters) {
        if (needed > 0 && w.isOffShift && !w.startShiftRequested) {
            w.requestShiftStart();
            needed--;
        }
    }
}

//turni da terminare
else if (currentlyOnShift > value) {
    int toRemove = currentlyOnShift - value;
    for (Waiter w : waiters) {
        if (toRemove > 0 && (!w.isOffShift && !w.endShiftRequested)) {
            w.requestShiftEnd();
            toRemove--;
        }
    }
}

registerWaitersShiftEvent(
	date(), 
	timeToDate(self.getTimeOfNextValue()), 
	value
);

//traceln("WAITERS: value: " + value + "\ncurrentlyOn: " + currentlyOnShift + "\nneeded: "+ (value - currentlyOnShift) + "\nterminate: " + (currentlyOnShift - value)+ "\n--");
]]></Action>
