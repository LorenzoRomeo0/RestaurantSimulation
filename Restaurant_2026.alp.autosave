				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1776170295472</Id>
					<Name><![CDATA[onShift]]></Name>
					<X>380</X><Y>80</Y>
					<Label><X>10</X><Y>10</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="100" Height="30">
						<EntryAction><![CDATA[isOffShift = false;
startShiftRequested = false;
wasOvertime = false;
lastShiftDay = date().getDay();

shiftStartDate = date();

_ps310.setFillColor(dodgerBlue);]]></EntryAction>
						<FillColor/>
					</Properties>
				</StatechartElement>
				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1776170316829</Id>
					<Name><![CDATA[offShift]]></Name>
					<X>670</X><Y>85</Y>
					<Label><X>10</X><Y>10</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="100" Height="30">
						<EntryAction><![CDATA[if(!endShiftRequested){ //era overtime
	wasOvertime = true;
	
	Date end = date();

	Calendar cal = Calendar.getInstance();
	cal.setTime(end);
	cal.set(Calendar.HOUR_OF_DAY, main.closingTime);
	cal.set(Calendar.MINUTE, 0);
	cal.set(Calendar.SECOND, 0);
	cal.set(Calendar.MILLISECOND, 0);
	
	Date overtimeStart = cal.getTime();
	
	if (end.before(overtimeStart)) {
	    cal.add(Calendar.DAY_OF_MONTH, -1);
	    overtimeStart = cal.getTime();
	}
	
	double value = (end.getTime() - overtimeStart.getTime()) / 3600000.0;
	
	if (value > 0 && value < 24) {
	    main.registerCookOvertimeEvent(overtimeStart, end, value);
		//traceln("current time: " + format(end) + " | registered an overtime of: " + value);
	};
}

shiftEndDate = date();

//main.register_cook_shift(shiftStartDate, shiftEndDate);

isOffShift = true;
endShiftRequested = false;


_ps310.setFillColor(red);]]></EntryAction>
						<FillColor/>
					</Properties>
				</StatechartElement>
