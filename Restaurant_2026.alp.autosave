					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int maxWaiters = 0;
for(double t = 0; t < 7 * 24; t += 1) { 
    int val = waiters_schedule.getValue(t, HOUR); 
    if(val > maxWaiters) {
        maxWaiters = val;
    }
}

return maxWaiters;]]></Body>
