				<Text>
					<Id>1769764285549</Id>
					<Name><![CDATA[text1]]></Name>
					<X>220</X><Y>640</Y>
					<Label><X>0</X><Y>-10</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<DrawMode>SHAPE_DRAW_2D</DrawMode>
					<EmbeddedIcon>false</EmbeddedIcon>
					<Z>0</Z>
					<Rotation>0.0</Rotation>
					<Color>-16777216</Color>
					<Text><![CDATA[Attenzione a far tornare a waiting nello stesso istante che viene liberata la risorsa dal seize!
In notify order done mando il messaggio al customer che nel suo statechart lo libera
dall'ordering wait che poi arriva al free() di questo waiter. Il waiter torna disponibile nel pool e 
quindi viene richiesto dal customer successivo,peò il messaggio mandato dall'onSeize non 
veniva processato da questo waiter, perché a causa si un delay di 1 minuto dopo il notify 
order done, all'arrivo del messaggio non si trovava nello stato waiting (che contiene la 
transizione del messaggio).]]></Text>
					<Font>
						<Name>SansSerif</Name>
						<Size>10</Size>
						<Style>0</Style>
					</Font>
					<Alignment>LEFT</Alignment>
				</Text>
				<Text>
					<Id>1769423548287</Id>
					<Name><![CDATA[text]]></Name>
					<X>5</X><Y>-10</Y>
					<Label><X>0</X><Y>-10</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<DrawMode>SHAPE_DRAW_2D</DrawMode>
					<EmbeddedIcon>false</EmbeddedIcon>
					<Z>10</Z>
					<Rotation>0.0</Rotation>
					<Color>-16777216</Color>
					<Text><![CDATA[text]]></Text>
					<TextCode><![CDATA[getId() +" [" + getIndex() +"] " + (waiter_statechart.getActiveSimpleState().name() 

 


)


/*
+ "\n" + (isOffShift ? "offShift":"onShift") + 
"\n" + "start " + shiftStartDate +  
"\n" + "end " + shiftEndDate + 
"\n" + "lastShift: " + lastShiftDay	+
"\n" + (isMoving() ? "moving":"") +
"\n" + (endShiftRequested ? "endRequested" : "") +
"\n" + (startShiftRequested ? "startRequested" : "") +
"\n" + (wasOvertime ? "wasOvertime" : "") 
*/]]></TextCode>
					<Font>
						<Name>SansSerif</Name>
						<Size>8</Size>
						<Style>0</Style>
					</Font>
					<Alignment>LEFT</Alignment>
				</Text>
			</Presentation>

