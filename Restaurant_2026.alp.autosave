					<Properties Width="150" Height="30">
						<EntryAction><![CDATA[traceln("--->" + getId() + "is being served by " + currentWaiter.getId());

Order order = new Order();
order.CustomerGroup = this;
order.complexity = (short) normal(1, 5, 3, 1);
order.desserts = (short) binomial(0.5, size); //TODO: migliorare
order.coffees = (short) binomial(0.5, size);  //TODO: migliorare

send(order,currentWaiter);











]]></EntryAction>
