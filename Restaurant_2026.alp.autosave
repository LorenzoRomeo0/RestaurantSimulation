								<Code><![CDATA[
Table t = (Table) unit;
int idx = nextOutsideTableIdx;

if (idx >= 0 && idx < outsideTablesSizes.length) {
    t.size = outsideTablesSizes[idx];
}

nextOutsideTableIdx++;
]]></Code>
