					<Action><![CDATA[// Contiamo quanti camerieri sono attualmente nel turno attivo o stanno iniziando
int currentlyOnShift = 0;
for (Waiter w : waiters) {
    if (!w.isOffShift || w.startShiftRequested) {
        currentlyOnShift++;
    }
}

// 1. Dobbiamo INIZIARE nuovi turni?
if (currentlyOnShift < value) {
    int needed = value - currentlyOnShift;
    for (Waiter w : waiters) {
        if (needed > 0 && w.isOffShift && !w.startShiftRequested) {
            w.requestShiftStart();
            needed--;
        }
    }
}
// 2. Dobbiamo TERMINARE dei turni?
else if (currentlyOnShift > value) {
    int toRemove = currentlyOnShift - value;
    for (Waiter w : waiters) {
        if (toRemove > 0 && (!w.isOffShift && !w.endShiftRequested)) {
            w.requestShiftEnd();
            toRemove--;
        }
    }
}]]></Action>
					<Intervals>
					</Intervals>
					<Exceptions>
					</Exceptions>
				</Schedule>
