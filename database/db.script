CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE MEMORY TABLE PUBLIC.AL_CONFIGURATION(PROPERTY_NAME VARCHAR(255) NOT NULL,PROPERTY_VALUE VARCHAR(16777216),UNIQUE(PROPERTY_NAME))
CREATE MEMORY TABLE PUBLIC.AL_GROUPS(GROUP_NAME VARCHAR(255) NOT NULL PRIMARY KEY,DESCRIPTION VARCHAR(16777216))
CREATE MEMORY TABLE PUBLIC.AL_TABLES(TABLE_NAME VARCHAR(255) NOT NULL PRIMARY KEY,GROUP_NAME VARCHAR(255),DESCRIPTION VARCHAR(16777216))
CREATE MEMORY TABLE PUBLIC.AL_CUSTOM_TYPE(TABLE_NAME VARCHAR(255),COLUMN_NAME VARCHAR(255),TYPE VARCHAR(255),NAME VARCHAR(255))
CREATE MEMORY TABLE PUBLIC.AL_VIEWS(VIEW_NAME VARCHAR(255) NOT NULL,VIEW_DEFINITION VARCHAR(16777216),IS_VALID BOOLEAN,UNIQUE(VIEW_NAME))
CREATE MEMORY TABLE PUBLIC.AL_SELECTED_LOG_OBJECTS(NAME VARCHAR(255) NOT NULL,TYPE VARCHAR(255),UNIQUE(NAME))
CREATE MEMORY TABLE PUBLIC.AL_DB_OBJECTS(NAME VARCHAR(255) NOT NULL,TYPE VARCHAR(255),USAGE VARCHAR(255),UNIQUE(NAME))
CREATE MEMORY TABLE PUBLIC.ARRIVAL_RATE_WEEK_GROUPSIZE(AL_ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,START_TIMESTAMP TIMESTAMP,END_TIMESTAMP TIMESTAMP,ARRIVAL_RATE INTEGER,WEEKDAY VARCHAR(16777216),HOUR VARCHAR(16777216),AVG_GROUP_SIZE DOUBLE)
ALTER TABLE PUBLIC.ARRIVAL_RATE_WEEK_GROUPSIZE ALTER COLUMN AL_ID RESTART WITH 119
CREATE MEMORY TABLE PUBLIC.ARRIVAL_RATE_WEEK_CONVERTED(AL_ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,START_TIMESTAMP TIMESTAMP,END_TIMESTAMP TIMESTAMP,ARRIVAL_RATE INTEGER,WEEKDAY VARCHAR(16777216),HOUR TIMESTAMP)
ALTER TABLE PUBLIC.ARRIVAL_RATE_WEEK_CONVERTED ALTER COLUMN AL_ID RESTART WITH 119
CREATE MEMORY TABLE PUBLIC.ARRIVAL_RATE_COMPLETE(AL_ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,START_TIMESTAMP TIMESTAMP,END_TIMESTAMP TIMESTAMP,ARRIVAL_RATE INTEGER)
ALTER TABLE PUBLIC.ARRIVAL_RATE_COMPLETE ALTER COLUMN AL_ID RESTART WITH 119
CREATE MEMORY TABLE PUBLIC.EATING_TIME(AL_ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,START_TIMESTAMP TIMESTAMP,END_TIMESTAMP TIMESTAMP,PERIOD VARCHAR(16777216),TIME_AVG INTEGER)
ALTER TABLE PUBLIC.EATING_TIME ALTER COLUMN AL_ID RESTART WITH 5
CREATE MEMORY TABLE PUBLIC.EMPLOYEES_SCHEDULE(AL_ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,START_TIMESTAMP TIMESTAMP,END_TIMESTAMP TIMESTAMP,WEEKDAY VARCHAR(16777216),HOUR TIMESTAMP,PERIOD VARCHAR(16777216),WAITERS INTEGER,COOKS INTEGER)
ALTER TABLE PUBLIC.EMPLOYEES_SCHEDULE ALTER COLUMN AL_ID RESTART WITH 35
CREATE MEMORY TABLE PUBLIC.TABLES_SELECTION(AL_ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,START_TIMESTAMP TIMESTAMP,END_TIMESTAMP TIMESTAMP,PERIOD VARCHAR(16777216),BAR_ON BOOLEAN,INSIDE_ON BOOLEAN,OUTSIDE_ON BOOLEAN,BAR_PRIO INTEGER,INSIDE_PRIO INTEGER,OUTSIDE_PRIO INTEGER)
ALTER TABLE PUBLIC.TABLES_SELECTION ALTER COLUMN AL_ID RESTART WITH 5
CREATE MEMORY TABLE PUBLIC.MENU_ITEMS(AL_ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,NAME VARCHAR(16777216),DAY_PART VARCHAR(16777216),CATEGORY VARCHAR(16777216),COURSE INTEGER,POPULARITY_WEIGHT INTEGER,PRICE DOUBLE,PREP_TIME_MEAN_MIN DOUBLE,PREP_TIME_SD_MIN DOUBLE,COMPLEXITY INTEGER,KITCHEN_STATION VARCHAR(16777216),REQUIRES_KITCHEN BOOLEAN,IS_COMBO BOOLEAN,IS_FIXED_MENU BOOLEAN,SERVICE_TIME_MEAN_MIN DOUBLE,EATING_TIME_MEAN_MIN INTEGER,AVAILABLE BOOLEAN)
ALTER TABLE PUBLIC.MENU_ITEMS ALTER COLUMN AL_ID RESTART WITH 32
ALTER SEQUENCE SYSTEM_LOBS.LOB_ID RESTART WITH 1
