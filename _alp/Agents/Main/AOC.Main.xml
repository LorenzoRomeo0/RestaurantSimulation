			<Action>int currentlyOnShift = 0;
for (Waiter w : waiters) {
    if (!w.isOffShift || w.startShiftRequested) {
        currentlyOnShift++;
    }
}

// turni da iniziare
if (currentlyOnShift &lt; value) {
    int needed = value - currentlyOnShift;
    for (Waiter w : waiters) {
        if (needed &gt; 0 &amp;&amp; w.isOffShift &amp;&amp; !w.startShiftRequested) {
            w.requestShiftStart();
            needed--;
        }
    }
}

//turni da terminare
else if (currentlyOnShift &gt; value) {
    int toRemove = currentlyOnShift - value;
    for (Waiter w : waiters) {
        if (toRemove &gt; 0 &amp;&amp; (!w.isOffShift &amp;&amp; !w.endShiftRequested)) {
            w.requestShiftEnd();
            toRemove--;
        }
    }
}

registerWaitersShiftEvent(
	date(), 
	timeToDate(self.getTimeOfNextValue()), 
	value
);

//traceln("WAITERS: value: " + value + "\ncurrentlyOn: " + currentlyOnShift + "\nneeded: "+ (value - currentlyOnShift) + "\nterminate: " + (currentlyOnShift - value)+ "\n--");
</Action>
